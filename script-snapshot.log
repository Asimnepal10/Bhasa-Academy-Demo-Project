const rangeOrder = ["10y", "5y", "3y", "1y", "ytd", "6m", "3m", "1m", "2w", "1w", "3d", "1d"];
const SESSION_STORAGE_KEY = "stockpilot-session-token";

const state = {
  sessionToken: (() => {
    try {
      return window.localStorage.getItem(SESSION_STORAGE_KEY);
    } catch {
      return null;
    }
  })(),
  bootstrap: null,
  user: null,
  selectedSymbol: null,
  selectedSector: "All sectors",
  selectedSort: "daily-desc",
  searchTerm: "",
  watchlistRange: "10y",
  analyticsRange: "10y",
  analyticsCompare: "benchmark",
  paperRange: "10y",
  selectedStrategy: null,
  startingCapital: 10000,
  learningFilter: "All levels",
  quizDifficulty: "Beginner",
  quizTopic: "All topics",
  quizPool: [],
  quizIndex: 0,
  quizScore: 0,
  quizAnswered: false,
  finalExamPool: [],
  finalExamIndex: 0,
  finalExamScore: 0,
  glossarySearch: "",
  coachResponse: "Ask the coach about a stock, a term, diversification, valuation, risk, backtesting, or paper trading."
};

const els = {};

function $(id) {
  return document.getElementById(id);
}

function cacheElements() {
  [
    "snapshotDateLabel","marketSummary","marketMoodLabel","marketMoodText","overviewMetrics","accountForm","accountEmail","accountUsername","accountPassword","logoutButton","accountStatus","accountSummary","selectedSymbol","selectedName","selectedSector","selectedPrice","selectedChange","selectedMarketCap","selectedMetrics","watchlistRangeSelect","trendChart","chartCaption","watchlistGrid","trackedCountTag","searchInput","sectorFilter","sortSelect","tableSummary","stockTableBody","tradeForm","tradeSearchInput","stockSuggestions","tradeSymbolSelect","tradeSide","tradeShares","tradePreview","resetPortfolioButton","tradeStatus","paperTradingSummary","paperTradingNarrative","paperRangeSelect","portfolioChart","positionsTableBody","tradeHistory","analyticsSelectedTag","analyticsRangeSelect","analyticsCompareSelect","analyticsMetrics","analyticsChart","analyticsNarrative","portfolioAnalyticsMetrics","aiSummaryBlock","strategySelect","startingCapital","runBacktestButton","backtestChart","backtestMetrics","strategySummary","backtestBreakdown","dailyChallengeTitle","dailyChallengeDescription","completeChallengeButton","dailyChallengeStatus","learningFilters","learningProgressText","learningProgressFill","lessonGrid","startFinalExamButton","finalExamStatus","quizDifficultySelect","quizTopicSelect","startQuizButton","quizMeta","quizQuestion","quizAnswers","quizFeedback","quizScore","quizNextButton","finalExamArea","gamesGrid","glossarySearch","glossarySummary","glossaryGrid","achievementOverview","achievementGrid","coachPrompts","coachForm","coachInput","coachSelectedStockButton","coachResponse","floatingDefinition","floatingDefinitionTitle","floatingDefinitionText","closeDefinitionButton","backToTopButton"
  ].forEach((id) => {
    els[id] = $(id);
  });
}

function formatCurrency(value, rounded = false) {
  return new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", maximumFractionDigits: rounded ? 0 : 2 }).format(value);
}

function formatPercent(value, digits = 2) {
  const prefix = value > 0 ? "+" : "";
  return `${prefix}${Number(value).toFixed(digits)}%`;
}

function getToneClass(value) {
  if (value > 0) return "positive";
  if (value < 0) return "negative";
  return "neutral";
}

function safeSetText(element, text) {
  if (element) element.textContent = text;
}

function safeSetHTML(element, html) {
  if (element) element.innerHTML = html;
}

function scrollToSection(sectionId) {
  const target = $(sectionId);
  if (target) target.scrollIntoView({ behavior: "smooth", block: "start" });
}

function persistSessionToken(token) {
  state.sessionToken = token || null;
  try {
    if (token) window.localStorage.setItem(SESSION_STORAGE_KEY, token);
    else window.localStorage.removeItem(SESSION_STORAGE_KEY);
  } catch {
    // ignore storage failures
  }
}

async function api(path, options = {}) {
  const headers = { "Content-Type": "application/json", ...(options.headers || {}) };
  if (state.sessionToken) headers["x-stockpilot-session"] = state.sessionToken;
  const response = await fetch(path, { ...options, headers });
  const data = await response.json().catch(() => ({}));
  if (!response.ok) {
    throw new Error(data.error || "Request failed.");
  }
  return data;
}

function getSelectedStock() {
  return state.bootstrap.stocks.find((stock) => stock.symbol === state.selectedSymbol) || state.bootstrap.stocks[0];
}

function getFiveYearCagr(stock) {
  const values = stock.history["5y"];
  return (Math.pow(values[values.length - 1] / values[0], 1 / 5) - 1) * 100;
}

function getTenYearCagr(stock) {
  const values = stock.history["10y"];
  return (Math.pow(values[values.length - 1] / values[0], 1 / 10) - 1) * 100;
}

function calculateReturn(values) {
  return ((values[values.length - 1] / values[0]) - 1) * 100;
}

function calculateMaxDrawdown(values) {
  let peak = values[0];
  let maxDrawdown = 0;
  values.forEach((value) => {
    peak = Math.max(peak, value);
    maxDrawdown = Math.min(maxDrawdown, ((value - peak) / peak) * 100);
  });
  return maxDrawdown;
}

function getFilteredStocks() {
  const term = state.searchTerm.trim().toLowerCase();
  let filtered = [...state.bootstrap.stocks];
  if (term) filtered = filtered.filter((stock) => `${stock.symbol} ${stock.name}`.toLowerCase().includes(term));
  if (state.selectedSector !== "All sectors") filtered = filtered.filter((stock) => stock.sector === state.selectedSector);

  switch (state.selectedSort) {
    case "fiveYear-desc":
      filtered.sort((a, b) => getFiveYearCagr(b) - getFiveYearCagr(a));
      break;
    case "tenYear-desc":
      filtered.sort((a, b) => getTenYearCagr(b) - getTenYearCagr(a));
      break;
    case "pe-asc":
      filtered.sort((a, b) => a.pe - b.pe);
      break;
    case "cap-desc":
      filtered.sort((a, b) => b.marketCap - a.marketCap);
      break;
    case "name-asc":
      filtered.sort((a, b) => a.name.localeCompare(b.name));
      break;
    default:
      filtered.sort((a, b) => b.dailyChange - a.dailyChange);
      break;
  }
  return filtered;
}

function drawChart(canvas, labels, datasets) {
  if (!canvas) return;
  const ctx = canvas.getContext("2d");
  const dpr = window.devicePixelRatio || 1;
  const width = canvas.clientWidth || Number(canvas.getAttribute("width")) || 640;
  const height = canvas.clientHeight || Number(canvas.getAttribute("height")) || 320;
  canvas.width = width * dpr;
  canvas.height = height * dpr;
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  ctx.clearRect(0, 0, width, height);

  const padding = { top: 28, right: 18, bottom: 38, left: 62 };
  const chartWidth = width - padding.left - padding.right;
  const chartHeight = height - padding.top - padding.bottom;
  const allValues = datasets.flatMap((dataset) => dataset.values);
  const min = Math.min(...allValues);
  const max = Math.max(...allValues);
  const range = max - min || 1;

  ctx.strokeStyle = "rgba(148, 163, 184, 0.12)";
  ctx.lineWidth = 1;
  for (let row = 0; row <= 5; row += 1) {
    const y = padding.top + (chartHeight / 5) * row;
    ctx.beginPath();
    ctx.moveTo(padding.left, y);
    ctx.lineTo(width - padding.right, y);
    ctx.stroke();
  }

  ctx.fillStyle = "#9fb0cf";
  ctx.font = '12px Inter, system-ui, sans-serif';
  ctx.textAlign = "right";
  for (let row = 0; row <= 5; row += 1) {
    const value = max - (range / 5) * row;
    const y = padding.top + (chartHeight / 5) * row;
    ctx.fillText(formatCurrency(value, true), padding.left - 8, y + 4);
  }

  ctx.textAlign = "center";
  labels.forEach((label, index) => {
    const x = padding.left + (chartWidth / (labels.length - 1 || 1)) * index;
    ctx.fillText(label, x, height - 10);
  });

  datasets.forEach((dataset) => {
    const points = dataset.values.map((value, index) => {
      const x = padding.left + (chartWidth / (dataset.values.length - 1 || 1)) * index;
      const normalized = (value - min) / range;
      const y = padding.top + chartHeight - normalized * chartHeight;
      return { x, y };
    });

    const gradient = ctx.createLinearGradient(0, padding.top, 0, height);
    gradient.addColorStop(0, `${dataset.color}44`);
    gradient.addColorStop(1, `${dataset.color}00`);

    ctx.beginPath();
    points.forEach((point, index) => {
      if (index === 0) ctx.moveTo(point.x, point.y);
      else ctx.lineTo(point.x, point.y);
    });
    ctx.lineTo(points[points.length - 1].x, height - padding.bottom);
    ctx.lineTo(points[0].x, height - padding.bottom);
    ctx.closePath();
    ctx.fillStyle = gradient;
    ctx.fill();

    ctx.beginPath();
    points.forEach((point, index) => {
      if (index === 0) ctx.moveTo(point.x, point.y);
      else ctx.lineTo(point.x, point.y);
    });
    ctx.strokeStyle = dataset.color;
    ctx.lineWidth = 3;
    ctx.stroke();
  });
}

function renderOverview() {
  const averageMove = state.bootstrap.stocks.reduce((sum, stock) => sum + stock.dailyChange, 0) / state.bootstrap.stocks.length;
  const best = [...state.bootstrap.stocks].sort((a, b) => getFiveYearCagr(b) - getFiveYearCagr(a))[0];
  const topMover = [...state.bootstrap.stocks].sort((a, b) => b.dailyChange - a.dailyChange)[0];

  safeSetText(els.snapshotDateLabel, state.bootstrap.snapshotDate);
  safeSetHTML(els.marketSummary, [
    { label: "Broad benchmark", value: formatCurrency(state.bootstrap.benchmark.currentPrice), detail: formatPercent(state.bootstrap.benchmark.dailyChange), tone: state.bootstrap.benchmark.dailyChange },
    { label: "Average tracked daily move", value: formatPercent(averageMove), detail: `${state.bootstrap.stocks.filter((stock) => stock.dailyChange > 0).length} stocks higher`, tone: averageMove },
    { label: "Top daily mover", value: topMover.symbol, detail: formatPercent(topMover.dailyChange), tone: topMover.dailyChange },
    { label: "Best five-year compounder", value: best.symbol, detail: formatPercent(getFiveYearCagr(best), 1), tone: getFiveYearCagr(best) }
  ].map((card) => `<article class="metric-card"><span>${card.label}</span><strong>${card.value}</strong><p class="${getToneClass(card.tone)}">${card.detail}</p></article>`).join(""));
  safeSetText(els.marketMoodLabel, averageMove < 0 ? "Markets closed with a cautious tone." : "Markets closed with a stable to positive tone.");
  safeSetText(els.marketMoodText, "All prices in this dynamic demo currently come from the embedded verified snapshot and are served through the backend API.");

  safeSetHTML(els.overviewMetrics, [
    { label: "Tracked stocks", value: String(state.bootstrap.stocks.length) },
    { label: "Lessons available", value: String(state.bootstrap.lessons.length) },
    { label: "Glossary terms", value: String(state.bootstrap.glossaryTerms.length) },
    { label: "Paper account value", value: state.user ? formatCurrency(state.user.paperAccountValue || 100000, true) : formatCurrency(100000, true) }
  ].map((item) => `<article class="metric-card"><span>${item.label}</span><strong>${item.value}</strong></article>`).join(""));
}

