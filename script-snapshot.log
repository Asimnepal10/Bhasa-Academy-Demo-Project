  if (els.tradeSymbolSelect) els.tradeSymbolSelect.value = stock.symbol;
  renderTradePreview();
}

function renderTable() {
  const filtered = getFilteredStocks();
  safeSetText(els.tableSummary, `Showing ${filtered.length} tracked stocks from the ${state.bootstrap.snapshotDate} snapshot.`);
  safeSetHTML(els.stockTableBody, filtered.map((stock) => `
    <tr data-symbol="${stock.symbol}" class="${stock.symbol === state.selectedSymbol ? "active-row" : ""}" tabindex="0">
      <td><strong>${stock.symbol}</strong></td>
      <td>${stock.name}</td>
      <td>${stock.sector}</td>
      <td>${formatCurrency(stock.currentPrice)}</td>
      <td class="${getToneClass(stock.dailyChange)}">${formatPercent(stock.dailyChange)}</td>
      <td>${formatPercent(getFiveYearCagr(stock), 1)}</td>
      <td>${stock.pe.toFixed(2)}</td>
      <td><button class="button button-secondary" type="button" data-symbol="${stock.symbol}">Load stock</button></td>
    </tr>
  `).join(""));
}

function renderTradePreview() {
  if (!els.tradeSymbolSelect || !els.tradeShares || !els.tradePreview) return;
  const stock = state.bootstrap.stocks.find((item) => item.symbol === els.tradeSymbolSelect.value) || getSelectedStock();
  const shares = Number(els.tradeShares.value || 1);
  safeSetHTML(els.tradePreview, `<strong>${stock.name}</strong><p>Estimated trade value: ${formatCurrency(stock.currentPrice * shares)}</p><p>Paper account cash available: ${formatCurrency(state.user?.paper?.cash || 100000, true)}</p>`);
}

function buildPaperSeries(range) {
  const labels = state.bootstrap.rangeLabels[range];
  const positions = Object.entries(state.user?.paper?.positions || {});
  const cash = state.user?.paper?.cash ?? 100000;
  if (!positions.length) return new Array(labels.length).fill(Number(cash.toFixed(2)));
  return labels.map((_, index) => {
    const holdingsValue = positions.reduce((sum, [symbol, position]) => {
      const stock = state.bootstrap.stocks.find((item) => item.symbol === symbol);
      const series = stock ? stock.history[range] : [];
      const point = series[Math.min(index, series.length - 1)] || 0;
      return sum + (position.shares * point);
    }, 0);
    return Number((cash + holdingsValue).toFixed(2));
  });
}

function renderPaperTrading() {
  const user = state.user;
  if (!user) return;
  const positions = Object.entries(user.paper.positions || {});
  safeSetHTML(els.paperTradingSummary, [
    { label: "Paper cash", value: formatCurrency(user.paper.cash, true) },
    { label: "Paper account value", value: formatCurrency(user.paperAccountValue, true) },
    { label: "Open positions", value: String(positions.length) },
    { label: "Trades placed", value: String(user.paper.history.length) }
  ].map((item) => `<article class="metric-card"><span>${item.label}</span><strong>${item.value}</strong></article>`).join(""));
  safeSetHTML(els.paperTradingNarrative, `<strong>Paper trading note</strong><p>Your holdings, cash, account value, and trade history are stored on the server and loaded through the application API.</p>`);
  safeSetHTML(els.positionsTableBody, positions.length ? positions.map(([symbol, position]) => {
    const stock = state.bootstrap.stocks.find((item) => item.symbol === symbol);
    const value = position.shares * (stock?.currentPrice || 0);
    const cost = position.shares * position.averageCost;
    const pnl = value - cost;
    return `<tr><td>${symbol}</td><td>${position.shares}</td><td>${formatCurrency(position.averageCost)}</td><td>${formatCurrency(value)}</td><td class="${getToneClass(pnl)}">${formatCurrency(pnl)}</td></tr>`;
  }).join("") : `<tr><td colspan="5">No open positions yet.</td></tr>`);
  safeSetHTML(els.tradeHistory, user.paper.history.length ? [...user.paper.history].reverse().map((trade) => `<article class="activity-item"><strong>${trade.type === 'buy' ? 'Buy' : 'Sell'} ${trade.symbol}</strong><p>${trade.shares} shares at ${formatCurrency(trade.price)} • ${new Date(trade.timestamp).toLocaleString()}</p></article>`).join("") : `<article class="activity-item"><strong>No trades yet</strong><p>Your trade log will appear here after your first trade.</p></article>`);
  drawChart(els.portfolioChart, state.bootstrap.rangeLabels[state.paperRange], [
    { label: "Paper account projection", values: buildPaperSeries(state.paperRange), color: "#60a5fa" },
    { label: getSelectedStock().name, values: getSelectedStock().history[state.paperRange], color: "#34d399" }
  ]);
  renderOverview();
}

function renderAnalytics() {
  const stock = getSelectedStock();
  const datasets = [{ label: stock.name, values: stock.history[state.analyticsRange], color: "#60a5fa" }];
  if (state.analyticsCompare === "benchmark") datasets.push({ label: state.bootstrap.benchmark.name, values: state.bootstrap.benchmark.history[state.analyticsRange], color: "#34d399" });
  drawChart(els.analyticsChart, state.bootstrap.rangeLabels[state.analyticsRange], datasets);
  safeSetText(els.analyticsSelectedTag, stock.symbol);
  const rangeReturn = calculateReturn(stock.history[state.analyticsRange]);
  safeSetHTML(els.analyticsMetrics, [
    { label: "Current price", value: formatCurrency(stock.currentPrice), tone: 0 },
    { label: "Daily change", value: formatPercent(stock.dailyChange), tone: stock.dailyChange },
    { label: "Five-year compound annual growth rate", value: formatPercent(getFiveYearCagr(stock), 1), tone: getFiveYearCagr(stock) },
    { label: "Ten-year compound annual growth rate", value: formatPercent(getTenYearCagr(stock), 1), tone: getTenYearCagr(stock) },
    { label: "Selected range return", value: formatPercent(rangeReturn, 1), tone: rangeReturn },
    { label: "Price to earnings ratio", value: stock.pe.toFixed(2), tone: 0 }
  ].map((metric) => `<article class="metric-card"><span>${metric.label}</span><strong class="${metric.tone ? getToneClass(metric.tone) : ""}">${metric.value}</strong></article>`).join(""));
  safeSetHTML(els.analyticsNarrative, `<strong>${stock.name}</strong><p>${stock.description}</p><p>Across the selected range, the stock returned ${formatPercent(rangeReturn, 1)}. Over five years its compound annual growth rate is ${formatPercent(getFiveYearCagr(stock), 1)} and over ten years it is ${formatPercent(getTenYearCagr(stock), 1)}.</p>`);
  safeSetHTML(els.portfolioAnalyticsMetrics, [
    { label: "Paper account value", value: formatCurrency(state.user?.paperAccountValue || 100000, true), tone: 0 },
    { label: "Paper account drawdown", value: formatPercent(calculateMaxDrawdown(state.user?.paper?.valueHistory || [100000]), 1), tone: calculateMaxDrawdown(state.user?.paper?.valueHistory || [100000]) },
    { label: "Best quiz score", value: String(state.user?.bestQuizScore || 0), tone: 0 },
    { label: "Achievements unlocked", value: String(state.user?.achievements?.length || 0), tone: 0 }
  ].map((metric) => `<article class="metric-card"><span>${metric.label}</span><strong class="${metric.tone ? getToneClass(metric.tone) : ""}">${metric.value}</strong></article>`).join(""));
  safeSetHTML(els.aiSummaryBlock, state.bootstrap.stocks.map((stockItem) => `<article class="activity-item"><strong>${stockItem.name}</strong><p>${stockItem.description}</p></article>`).join(""));
}

async function renderBacktest() {
  const data = await api(`/api/backtest/${encodeURIComponent(state.selectedStrategy)}?capital=${encodeURIComponent(state.startingCapital)}`);
  drawChart(els.backtestChart, ["Start", ...data.breakdown.map((item) => String(item.year))], [
    { label: data.strategy.name, values: [state.startingCapital, ...data.breakdown.map((item) => Number(item.strategyValue.toFixed(2)))], color: "#60a5fa" },
    { label: state.bootstrap.benchmark.name, values: [state.startingCapital, ...data.breakdown.map((item) => Number(item.benchmarkValue.toFixed(2)))], color: "#34d399" }
  ]);
  safeSetHTML(els.backtestMetrics, [
    { label: "Final strategy value", value: formatCurrency(data.finalStrategyValue, true), tone: 0 },
    { label: "Strategy total return", value: formatPercent(data.totalReturn, 1), tone: data.totalReturn },
    { label: "Benchmark total return", value: formatPercent(data.benchmarkReturn, 1), tone: data.benchmarkReturn },
    { label: "Compound annual growth rate", value: formatPercent(data.compoundAnnualGrowthRate, 1), tone: data.compoundAnnualGrowthRate },
    { label: "Outperformance gap", value: formatPercent(data.outperformanceGap, 1), tone: data.outperformanceGap }
  ].map((metric) => `<article class="metric-card"><span>${metric.label}</span><strong class="${metric.tone ? getToneClass(metric.tone) : ""}">${metric.value}</strong></article>`).join(""));
  safeSetHTML(els.strategySummary, `<strong>${data.strategy.name}</strong><p>${data.strategy.rationale}</p><p>This strategy ${data.totalReturn >= data.benchmarkReturn ? 'outperformed' : 'underperformed'} the broad market benchmark by ${formatPercent(data.outperformanceGap, 1)} across the backtest window.</p>`);
  safeSetHTML(els.backtestBreakdown, data.breakdown.map((item) => `<article class="activity-item"><strong>${item.year}</strong><p>Strategy ${formatPercent(item.strategyReturn, 1)} versus benchmark ${formatPercent(item.benchmarkReturn, 1)}.</p><p>Strategy value ${formatCurrency(item.strategyValue, true)} • benchmark value ${formatCurrency(item.benchmarkValue, true)}</p></article>`).join(""));
}

function renderDailyChallenge() {
  const challenge = state.bootstrap.dailyChallenge;
  safeSetText(els.dailyChallengeTitle, challenge.title);
  safeSetText(els.dailyChallengeDescription, challenge.description);
  const completed = Boolean(state.user?.lastChallengeKey && state.user.lastChallengeKey.includes(challenge.id));
  safeSetText(els.dailyChallengeStatus, completed ? "You already completed today’s challenge." : "Today’s challenge is available.");
}

function renderLearning() {
  const lessons = state.bootstrap.lessons.filter((lesson) => state.learningFilter === "All levels" || lesson.difficulty === state.learningFilter);
  const completedCount = state.user?.completedLessons?.length || 0;
  safeSetText(els.learningProgressText, `${completedCount} of ${state.bootstrap.lessons.length} lessons completed.`);
  if (els.learningProgressFill) els.learningProgressFill.style.width = `${(completedCount / state.bootstrap.lessons.length) * 100}%`;
  safeSetHTML(els.learningFilters, ["All levels", "Beginner", "Intermediate", "Advanced"].map((filter) => `<button class="button button-secondary ${state.learningFilter === filter ? 'active-pill' : ''}" type="button" data-learning-filter="${filter}">${filter}</button>`).join(""));
  safeSetHTML(els.lessonGrid, lessons.map((lesson) => `<article class="card"><div class="card-title-row"><div><p class="eyebrow">${lesson.difficulty}</p><h3>${lesson.title}</h3></div><span class="tag">${state.user?.completedLessons?.includes(lesson.id) ? 'Completed' : 'Lesson'}</span></div><p>${lesson.summary}</p><div class="summary-block"><strong>Try it yourself</strong>${lesson.prompts.map((prompt) => `<p>${prompt}</p>`).join("")}</div><div class="button-row"><button class="button button-secondary" type="button" data-complete-lesson="${lesson.id}">${state.user?.completedLessons?.includes(lesson.id) ? 'Completed' : 'Mark complete'}</button></div></article>`).join(""));
}

function buildQuizPool() {
  return state.bootstrap.quizBank.filter((quiz) => quiz.difficulty === state.quizDifficulty && (state.quizTopic === "All topics" || quiz.topic === state.quizTopic));
}

function renderQuiz() {
  if (!state.quizPool.length) state.quizPool = buildQuizPool();
  if (!state.quizPool.length) return;
  const question = state.quizPool[state.quizIndex % state.quizPool.length];
  safeSetText(els.quizMeta, `${state.quizDifficulty} • ${state.quizTopic} • Best score ${state.user?.bestQuizScore || 0}`);
  safeSetText(els.quizQuestion, question.question);
  safeSetHTML(els.quizAnswers, question.answers.map((answer, index) => `<button class="button button-secondary quiz-answer" type="button" data-quiz-answer="${index}" ${state.quizAnswered ? 'disabled' : ''}>${answer}</button>`).join(""));
  safeSetText(els.quizScore, `Score: ${state.quizScore}`);
}

function renderFinalExam() {
  if (!state.finalExamPool.length) {
    safeSetText(els.finalExamArea, "Start the final exam from the Learning Hub when ready.");
    return;
  }
  const question = state.finalExamPool[state.finalExamIndex];
  safeSetHTML(els.finalExamArea, `<strong>Question ${state.finalExamIndex + 1} of ${state.finalExamPool.length}</strong><p>${question.question}</p><div class="quiz-answers">${question.answers.map((answer, index) => `<button class="button button-secondary quiz-answer" type="button" data-final-answer="${index}">${answer}</button>`).join("")}</div><p class="form-status">Score: ${state.finalExamScore}</p>`);
}

function renderGames() {
  safeSetHTML(els.gamesGrid, state.bootstrap.games.map((game) => `<article class="card"><div class="card-title-row"><h3>${game.title}</h3><span class="tag">Mini-game</span></div><p>${game.description}</p><div class="summary-block"><strong>${game.prompt}</strong><div class="button-row"><button class="button button-secondary" type="button" data-game-play="${game.id}">Play now</button></div></div></article>`).join(""));
}

function renderGlossary() {
  const search = state.glossarySearch.trim().toLowerCase();
  const filtered = search ? state.bootstrap.glossaryTerms.filter((term) => `${term.term} ${term.shortDefinition} ${term.longDefinition}`.toLowerCase().includes(search)) : state.bootstrap.glossaryTerms;
  safeSetText(els.glossarySummary, `Showing ${filtered.length} glossary terms.`);
  safeSetHTML(els.glossaryGrid, filtered.map((term) => `<article class="glossary-card"><div class="card-title-row"><h3>${term.term}</h3><button class="button button-secondary" type="button" data-open-definition="${term.term}">Quick definition</button></div><p>${term.shortDefinition}</p><div class="summary-block"><strong>Detailed explanation</strong><p>${term.longDefinition}</p></div><div class="summary-block"><strong>Try it yourself</strong><p>${term.question}</p><div class="button-row"><button class="button button-secondary" type="button" data-reveal-glossary="${term.term}">Reveal answer</button></div><p id="glossary-answer-${term.term.toLowerCase().replace(/[^a-z0-9]+/g, '-')}">${state.user?.glossaryReveals?.includes(term.term) ? term.answer : 'Answer hidden until reveal.'}</p></div></article>`).join(""));
}

function renderAchievements() {
  safeSetHTML(els.achievementOverview, [
    { label: "Unlocked achievements", value: String(state.user?.achievements?.length || 0) },
    { label: "Completed lessons", value: String(state.user?.completedLessons?.length || 0) },
    { label: "Best quiz score", value: String(state.user?.bestQuizScore || 0) },
    { label: "Paper trades", value: String(state.user?.paper?.history?.length || 0) }
  ].map((item) => `<article class="metric-card"><span>${item.label}</span><strong>${item.value}</strong></article>`).join(""));
  const achievementDefinitions = state.bootstrap.achievementDefinitions || [];
  safeSetHTML(els.achievementGrid, achievementDefinitions.map((achievement) => `<article class="achievement-card ${(state.user?.achievements || []).includes(achievement.id) ? 'unlocked' : ''}"><div class="card-title-row"><h3>${achievement.title}</h3><span class="tag">${(state.user?.achievements || []).includes(achievement.id) ? 'Unlocked' : 'Locked'}</span></div><p>${achievement.description}</p></article>`).join(""));
}

function renderCoach() {
  safeSetHTML(els.coachPrompts, state.bootstrap.coachPrompts.map((prompt) => `<button class="button button-secondary" type="button" data-coach-prompt="${prompt}">${prompt}</button>`).join(""));
  safeSetText(els.coachResponse, state.coachResponse);
}

function openDefinition(termName) {
  const term = state.bootstrap.glossaryTerms.find((item) => item.term === termName);
  if (!term || !els.floatingDefinition) return;
  safeSetText(els.floatingDefinitionTitle, term.term);
  safeSetText(els.floatingDefinitionText, term.longDefinition);
  els.floatingDefinition.classList.remove("hidden");
}

function closeDefinition() {
  if (els.floatingDefinition) els.floatingDefinition.classList.add("hidden");
}

async function createGuestSession() {
  const data = await api('/api/auth/guest', { method: 'POST' });
  persistSessionToken(data.sessionToken);
  state.user = data.user;
}

async function refreshMe() {
  if (!state.sessionToken) return;
  const data = await api('/api/me');
  state.user = data.user;
}

async function bootstrap() {
  cacheElements();
  state.bootstrap = await api('/api/bootstrap');
  state.selectedSymbol = state.bootstrap.stocks[0].symbol;
  state.selectedStrategy = state.bootstrap.strategies[0].id;
  if (state.sessionToken) {
    try {
      await refreshMe();
    } catch {
      persistSessionToken(null);
      await createGuestSession();
    }
  } else {
    await createGuestSession();
  }
  renderSelectors();
  renderOverview();
  renderAccount();
  renderWatchlist();
  renderSelectedStock();
  renderTable();
  renderPaperTrading();
  renderAnalytics();
  await renderBacktest();
  renderDailyChallenge();
  renderLearning();
  state.quizPool = buildQuizPool();
  renderQuiz();
  renderFinalExam();
  renderGames();
  renderGlossary();
  renderAchievements();
  renderCoach();
  bindEvents();
}

function bindEvents() {
  document.querySelectorAll('[data-scroll-target]').forEach((element) => {
    element.addEventListener('click', (event) => {
      event.preventDefault();
      scrollToSection(element.dataset.scrollTarget);
    });
  });

  if (els.accountForm) {
    els.accountForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      try {
        let data;
        const payload = {
          email: els.accountEmail.value,
          username: els.accountUsername.value,
          password: els.accountPassword.value
        };
        if (!state.user || state.user.isGuest) {
          try {
            data = await api('/api/auth/register', {
              method: 'POST',
              body: JSON.stringify(payload)
            });
            persistSessionToken(data.sessionToken);
            safeSetText(els.accountStatus, 'Profile created successfully.');
          } catch (error) {
            data = await api('/api/auth/login', {
              method: 'POST',
              body: JSON.stringify({ identifier: payload.email || payload.username, password: payload.password })
            });
            persistSessionToken(data.sessionToken);
            safeSetText(els.accountStatus, 'Logged in successfully.');
          }
        } else {
          data = await api('/api/me/profile', {
            method: 'PUT',
            body: JSON.stringify(payload)
          });
          safeSetText(els.accountStatus, 'Profile updated successfully.');
        }
        state.user = data.user;
        renderAccount();
        renderAchievements();
        renderOverview();
      } catch (error) {
        safeSetText(els.accountStatus, error.message);
      }
    });
  }

  if (els.logoutButton) {
    els.logoutButton.addEventListener('click', async () => {
      if (state.sessionToken) {
        try { await api('/api/auth/logout', { method: 'POST' }); } catch {}
      }
      persistSessionToken(null);
      await createGuestSession();
      renderAccount();
      renderPaperTrading();
      renderAchievements();
      renderOverview();
    });
  }

  els.watchlistGrid?.addEventListener('click', (event) => {
    const button = event.target.closest('[data-symbol]');
    if (button) {
      state.selectedSymbol = button.dataset.symbol;
      renderWatchlist();
      renderSelectedStock();
      renderAnalytics();
      renderTable();
      renderTradePreview();
      if (els.tradeSymbolSelect) els.tradeSymbolSelect.value = state.selectedSymbol;
    }
  });

  els.stockTableBody?.addEventListener('click', (event) => {
    const button = event.target.closest('[data-symbol]');
    if (button) {
      state.selectedSymbol = button.dataset.symbol;
      renderWatchlist();
      renderSelectedStock();
      renderAnalytics();
      renderTable();
      renderTradePreview();
      if (els.tradeSymbolSelect) els.tradeSymbolSelect.value = state.selectedSymbol;
    }
  });

  els.searchInput?.addEventListener('input', (event) => {
    state.searchTerm = event.target.value;
    renderTable();
  });

  els.sectorFilter?.addEventListener('change', (event) => {
    state.selectedSector = event.target.value;
    renderTable();
  });

  els.sortSelect?.addEventListener('change', (event) => {
    state.selectedSort = event.target.value;
    renderTable();
  });

  els.watchlistRangeSelect?.addEventListener('change', (event) => {
    state.watchlistRange = event.target.value;
    renderSelectedStock();
  });

  document.querySelector('.action-select-trade')?.addEventListener('click', () => scrollToSection('simulator'));
  document.querySelector('.action-select-analytics')?.addEventListener('click', () => scrollToSection('analytics'));
  document.querySelector('.action-select-coach')?.addEventListener('click', async () => {
    if (els.coachInput) els.coachInput.value = `Summarize ${state.selectedSymbol} for me.`;
    const data = await api('/api/coach/ask', { method: 'POST', body: JSON.stringify({ question: els.coachInput?.value || '', selectedSymbol: state.selectedSymbol }) });
    state.coachResponse = data.response;
    state.user = data.user;
    renderCoach();
    renderAchievements();
    scrollToSection('coach');
  });

  els.tradeSearchInput?.addEventListener('input', (event) => {
    const value = event.target.value.toLowerCase();
    const match = state.bootstrap.stocks.find((stock) => stock.symbol.toLowerCase() === value || stock.name.toLowerCase() === value);
    if (match) {
      state.selectedSymbol = match.symbol;
      if (els.tradeSymbolSelect) els.tradeSymbolSelect.value = match.symbol;
      renderWatchlist();
      renderSelectedStock();
      renderAnalytics();
    }
  });

  els.tradeSymbolSelect?.addEventListener('change', (event) => {
    state.selectedSymbol = event.target.value;
    renderWatchlist();
    renderSelectedStock();
    renderAnalytics();
  });

  els.tradeShares?.addEventListener('input', renderTradePreview);

  els.tradeForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    try {
      const data = await api('/api/paper/trade', { method: 'POST', body: JSON.stringify({ side: els.tradeSide.value, symbol: els.tradeSymbolSelect.value, shares: Number(els.tradeShares.value) }) });
      state.user = data.user;
      safeSetText(els.tradeStatus, data.message);
      if (els.tradeStatus) els.tradeStatus.className = 'form-status positive';
      renderPaperTrading();
      renderOverview();
      renderAchievements();
      renderAccount();
    } catch (error) {
      safeSetText(els.tradeStatus, error.message);
      if (els.tradeStatus) els.tradeStatus.className = 'form-status negative';
    }
  });

  els.resetPortfolioButton?.addEventListener('click', async () => {
    const data = await api('/api/paper/reset', { method: 'POST' });
    state.user = data.user;
    safeSetText(els.tradeStatus, 'Paper trading account reset.');
    renderPaperTrading();
    renderOverview();
    renderAchievements();
    renderAccount();
  });

  els.paperRangeSelect?.addEventListener('change', (event) => {
    state.paperRange = event.target.value;
    renderPaperTrading();
  });

  els.analyticsRangeSelect?.addEventListener('change', (event) => {
    state.analyticsRange = event.target.value;
    renderAnalytics();
  });

  els.analyticsCompareSelect?.addEventListener('change', (event) => {
    state.analyticsCompare = event.target.value;
    renderAnalytics();
  });

  els.strategySelect?.addEventListener('change', (event) => {
    state.selectedStrategy = event.target.value;
    renderBacktest();
  });

  els.startingCapital?.addEventListener('input', (event) => {
    state.startingCapital = Number(event.target.value) || 10000;
  });

  els.runBacktestButton?.addEventListener('click', async () => {
    await renderBacktest();
    scrollToSection('backtest');
  });

  els.completeChallengeButton?.addEventListener('click', async () => {
    const data = await api('/api/challenge/complete', { method: 'POST' });
    state.user = data.user;
    renderDailyChallenge();
    renderAchievements();
    renderAccount();
  });

  els.learningFilters?.addEventListener('click', (event) => {
    const button = event.target.closest('[data-learning-filter]');
    if (!button) return;
    state.learningFilter = button.dataset.learningFilter;
    renderLearning();
  });

  els.lessonGrid?.addEventListener('click', async (event) => {
    const button = event.target.closest('[data-complete-lesson]');
    if (!button) return;
    const data = await api('/api/lessons/complete', { method: 'POST', body: JSON.stringify({ lessonId: button.dataset.completeLesson }) });
    state.user = data.user;
    renderLearning();
    renderAchievements();
    renderAccount();
  });

  els.quizDifficultySelect?.addEventListener('change', (event) => {
    state.quizDifficulty = event.target.value;
    state.quizPool = buildQuizPool();
    state.quizIndex = 0;
    state.quizScore = 0;
    state.quizAnswered = false;
    renderQuiz();
  });

  els.quizTopicSelect?.addEventListener('change', (event) => {
    state.quizTopic = event.target.value;
    state.quizPool = buildQuizPool();
    state.quizIndex = 0;
    state.quizScore = 0;
    state.quizAnswered = false;
    renderQuiz();
  });

  els.startQuizButton?.addEventListener('click', () => {
    state.quizPool = buildQuizPool();
    state.quizIndex = 0;
    state.quizScore = 0;
    state.quizAnswered = false;
    renderQuiz();
  });

  els.quizAnswers?.addEventListener('click', async (event) => {
    const button = event.target.closest('[data-quiz-answer]');
    if (!button || state.quizAnswered) return;
    const question = state.quizPool[state.quizIndex % state.quizPool.length];
    state.quizAnswered = true;
    if (Number(button.dataset.quizAnswer) === question.correctIndex) {
      state.quizScore += 1;
      safeSetText(els.quizFeedback, `Correct. ${question.explanation}`);
      if (els.quizFeedback) els.quizFeedback.className = 'form-status positive';
    } else {
      safeSetText(els.quizFeedback, `Not quite. ${question.explanation}`);
      if (els.quizFeedback) els.quizFeedback.className = 'form-status negative';
    }
    const data = await api('/api/quiz/submit', { method: 'POST', body: JSON.stringify({ score: state.quizScore }) });
    state.user = data.user;
    renderQuiz();
    renderAchievements();
    renderAccount();
  });

  els.quizNextButton?.addEventListener('click', () => {
    if (!state.quizPool.length) return;
    state.quizIndex = (state.quizIndex + 1) % state.quizPool.length;
    state.quizAnswered = false;
    safeSetText(els.quizFeedback, '');
    if (els.quizFeedback) els.quizFeedback.className = 'feedback-text';
    renderQuiz();
  });

  els.startFinalExamButton?.addEventListener('click', () => {
    state.finalExamPool = [...state.bootstrap.quizBank].sort(() => Math.random() - 0.5).slice(0, 12);
    state.finalExamIndex = 0;
    state.finalExamScore = 0;
    renderFinalExam();
    scrollToSection('quiz-center');
  });

  els.finalExamArea?.addEventListener('click', async (event) => {
    const button = event.target.closest('[data-final-answer]');
    if (!button || !state.finalExamPool.length) return;
    const question = state.finalExamPool[state.finalExamIndex];
    if (Number(button.dataset.finalAnswer) === question.correctIndex) state.finalExamScore += 1;
    state.finalExamIndex += 1;
    if (state.finalExamIndex >= state.finalExamPool.length) {
      const percentage = Math.round((state.finalExamScore / state.finalExamPool.length) * 100);
      const data = await api('/api/quiz/submit', { method: 'POST', body: JSON.stringify({ finalExamScore: percentage }) });
      state.user = data.user;
      safeSetHTML(els.finalExamArea, `<strong>Final exam complete</strong><p>Your score was ${state.finalExamScore} out of ${state.finalExamPool.length}. ${percentage >= 70 ? 'You passed the final exam.' : 'You can retake the exam anytime.'}</p>`);
      safeSetText(els.finalExamStatus, percentage >= 70 ? 'Final exam passed.' : 'Final exam completed, but not yet passed.');
      renderAchievements();
      renderAccount();
      return;
    }
    renderFinalExam();
  });

  els.gamesGrid?.addEventListener('click', (event) => {
    const button = event.target.closest('[data-game-play]');
    if (!button) return;
    const game = state.bootstrap.games.find((item) => item.id === button.dataset.gamePlay);
    if (!game) return;
    if (game.id === 'return-ranker') {
      const best = [...state.bootstrap.stocks].sort((a, b) => getFiveYearCagr(b) - getFiveYearCagr(a))[0];
      state.coachResponse = `${best.name} currently has the strongest five-year compound annual growth rate among the tracked stocks.`;
    } else if (game.id === 'sector-match') {
      const stock = getSelectedStock();
      state.coachResponse = `${stock.name} belongs to the ${stock.sector} sector.`;
    } else {
      const term = state.bootstrap.glossaryTerms[Math.floor(Math.random() * state.bootstrap.glossaryTerms.length)];
      state.coachResponse = `${term.term}: ${term.shortDefinition}`;
    }
    renderCoach();
    scrollToSection('coach');
  });

  els.glossarySearch?.addEventListener('input', (event) => {
    state.glossarySearch = event.target.value;
    renderGlossary();
  });

  els.glossaryGrid?.addEventListener('click', async (event) => {
    const revealButton = event.target.closest('[data-reveal-glossary]');
    const definitionButton = event.target.closest('[data-open-definition]');
    if (revealButton) {
      const data = await api('/api/glossary/reveal', { method: 'POST', body: JSON.stringify({ term: revealButton.dataset.revealGlossary }) });
      state.user = data.user;
      renderGlossary();
      renderAchievements();
    }
    if (definitionButton) openDefinition(definitionButton.dataset.openDefinition);
  });

  els.coachPrompts?.addEventListener('click', async (event) => {
    const button = event.target.closest('[data-coach-prompt]');
    if (!button) return;
    if (els.coachInput) els.coachInput.value = button.dataset.coachPrompt;
    const data = await api('/api/coach/ask', { method: 'POST', body: JSON.stringify({ question: button.dataset.coachPrompt, selectedSymbol: state.selectedSymbol }) });
    state.coachResponse = data.response;
    state.user = data.user;
    renderCoach();
    renderAchievements();
    renderAccount();
  });

  els.coachForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = await api('/api/coach/ask', { method: 'POST', body: JSON.stringify({ question: els.coachInput?.value || '', selectedSymbol: state.selectedSymbol }) });
    state.coachResponse = data.response;
    state.user = data.user;
    renderCoach();
    renderAchievements();
    renderAccount();
  });

  els.coachSelectedStockButton?.addEventListener('click', async () => {
    const question = `Summarize ${state.selectedSymbol} for me.`;
    const data = await api('/api/coach/ask', { method: 'POST', body: JSON.stringify({ question, selectedSymbol: state.selectedSymbol }) });
    state.coachResponse = data.response;
    state.user = data.user;
    renderCoach();
    renderAchievements();
    renderAccount();
  });

  els.closeDefinitionButton?.addEventListener('click', closeDefinition);
  els.floatingDefinition?.addEventListener('click', (event) => {
    if (event.target.id === 'floatingDefinition') closeDefinition();
  });

  els.backToTopButton?.addEventListener('click', () => scrollToSection('overview'));

  window.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeDefinition();
  });

  window.addEventListener('resize', async () => {
    renderSelectedStock();
    renderPaperTrading();
    renderAnalytics();
    await renderBacktest();
  });
}

bootstrap().catch((error) => {
  console.error(error);
  document.body.innerHTML = `<div style="padding:24px;color:white;font-family:Arial,sans-serif;"><h1>StockPilot failed to load</h1><p>${error.message}</p></div>`;
});
